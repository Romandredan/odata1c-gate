<?xml version="1.0" encoding="UTF-8"?>
<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx">
  <edmx:DataServices m:DataServiceVersion="3.0"
                     xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata">
    <Schema Namespace="StandardODATA" xmlns="http://schemas.microsoft.com/ado/2009/11/edm">

      <EntityType Name="Catalog_Контрагенты">
        <Key><PropertyRef Name="Ref_Key"/></Key>
        <Property Name="Ref_Key" Type="Edm.Guid" Nullable="false"/>
        <Property Name="Code" Type="Edm.String" Nullable="false"/>
        <Property Name="Description" Type="Edm.String" Nullable="false"/>
        <Property Name="ИНН" Type="Edm.String" Nullable="true"/>
        <Property Name="КПП" Type="Edm.String" Nullable="true"/>
        <Property Name="ЮридическоеФизическоеЛицо" Type="Edm.String" Nullable="true"/>
        <Property Name="DeletionMark" Type="Edm.Boolean" Nullable="false"/>
        <Property Name="ГоловнойКонтрагент_Key" Type="Edm.Guid" Nullable="true"/>
        <NavigationProperty Name="ГоловнойКонтрагент"
                            Relationship="StandardODATA.Catalog_Контрагенты_ГоловнойКонтрагент"
                            FromRole="Catalog_Контрагенты" ToRole="Catalog_Контрагенты1"/>
      </EntityType>

      <EntityType Name="Document_РеализацияТоваровУслуг">
        <Key><PropertyRef Name="Ref_Key"/></Key>
        <Property Name="Ref_Key" Type="Edm.Guid" Nullable="false"/>
        <Property Name="Number" Type="Edm.String" Nullable="false"/>
        <Property Name="Date" Type="Edm.DateTime" Nullable="false"/>
        <Property Name="Posted" Type="Edm.Boolean" Nullable="false"/>
        <Property Name="DeletionMark" Type="Edm.Boolean" Nullable="false"/>
        <Property Name="СуммаДокумента" Type="Edm.Decimal" Nullable="true"/>
        <Property Name="Контрагент_Key" Type="Edm.Guid" Nullable="true"/>
      </EntityType>

      <EntityType Name="Document_РеализацияТоваровУслуг_Товары">
        <Key>
          <PropertyRef Name="Ref_Key"/>
          <PropertyRef Name="LineNumber"/>
        </Key>
        <Property Name="Ref_Key" Type="Edm.Guid" Nullable="false"/>
        <Property Name="LineNumber" Type="Edm.String" Nullable="false"/>
        <Property Name="Номенклатура_Key" Type="Edm.Guid" Nullable="true"/>
        <Property Name="Количество" Type="Edm.Decimal" Nullable="true"/>
        <Property Name="Сумма" Type="Edm.Decimal" Nullable="true"/>
      </EntityType>

      <EntityType Name="InformationRegister_КурсыВалют">
        <Key>
          <PropertyRef Name="Period"/>
          <PropertyRef Name="Валюта_Key"/>
        </Key>
        <Property Name="Period" Type="Edm.DateTime" Nullable="false"/>
        <Property Name="Валюта_Key" Type="Edm.Guid" Nullable="false"/>
        <Property Name="Курс" Type="Edm.Decimal" Nullable="true"/>
      </EntityType>

      <EntityType Name="InformationRegister_СостоянияЗаказов">
        <Key>
          <PropertyRef Name="Recorder"/>
          <PropertyRef Name="LineNumber"/>
        </Key>
        <Property Name="Recorder" Type="Edm.Guid" Nullable="false"/>
        <Property Name="Recorder_Type" Type="Edm.String" Nullable="false"/>
        <Property Name="LineNumber" Type="Edm.String" Nullable="false"/>
        <Property Name="Период" Type="Edm.DateTime" Nullable="true"/>
        <Property Name="Состояние" Type="Edm.String" Nullable="true"/>
      </EntityType>

      <!-- Невиртуальный регистр накопления с ключом из одних измерений (без Recorder среди
           ключей) — правка по итогам финального ревью M1b (Important, задача 3). Единственная
           виртуальная таблица образца (InformationRegister_КурсыВалют_SliceLast, строится
           действием SliceLast ниже) — регистра сведений, отсекается через is_virtual, поэтому
           мутация «признак независимого регистра сведений → признак вида, оканчивающегося на
           „регистр“» не ловилась ни одним тестом. Эта сущность — не типовой факт из реального
           $metadata (в 1С регистр накопления обычно связан с регистратором), а минимальный
           случай, ловящий именно такую мутацию: TestИндекс_ошибочно_независимый_регистр в
           test_index_edmx.py. -->
      <EntityType Name="AccumulationRegister_ОстаткиНаСчетах">
        <Key>
          <PropertyRef Name="Счет_Key"/>
          <PropertyRef Name="Валюта_Key"/>
        </Key>
        <Property Name="Счет_Key" Type="Edm.Guid" Nullable="false"/>
        <Property Name="Валюта_Key" Type="Edm.Guid" Nullable="false"/>
        <Property Name="Сумма" Type="Edm.Decimal" Nullable="true"/>
      </EntityType>

      <EntityType Name="Catalog_БанковскиеСчета">
        <Key><PropertyRef Name="Ref_Key"/></Key>
        <Property Name="Ref_Key" Type="Edm.Guid" Nullable="false"/>
        <Property Name="Description" Type="Edm.String" Nullable="false"/>
        <Property Name="НомерСчета" Type="Edm.String" Nullable="true"/>
        <Property Name="Владелец_Key" Type="Edm.Guid" Nullable="true"/>
        <Property Name="Владелец_Type" Type="Edm.String" Nullable="true"/>
      </EntityType>

      <EntityContainer Name="StandardODATA" m:IsDefaultEntityContainer="true">
        <EntitySet Name="Catalog_Контрагенты" EntityType="StandardODATA.Catalog_Контрагенты"/>
        <EntitySet Name="Document_РеализацияТоваровУслуг"
                   EntityType="StandardODATA.Document_РеализацияТоваровУслуг"/>
        <EntitySet Name="Document_РеализацияТоваровУслуг_Товары"
                   EntityType="StandardODATA.Document_РеализацияТоваровУслуг_Товары"/>
        <EntitySet Name="InformationRegister_КурсыВалют"
                   EntityType="StandardODATA.InformationRegister_КурсыВалют"/>
        <EntitySet Name="InformationRegister_СостоянияЗаказов"
                   EntityType="StandardODATA.InformationRegister_СостоянияЗаказов"/>
        <EntitySet Name="AccumulationRegister_ОстаткиНаСчетах"
                   EntityType="StandardODATA.AccumulationRegister_ОстаткиНаСчетах"/>
        <EntitySet Name="Catalog_БанковскиеСчета" EntityType="StandardODATA.Catalog_БанковскиеСчета"/>
        <FunctionImport Name="Post" IsBindable="true" IsSideEffecting="true">
          <Parameter Name="bindingParameter" Type="StandardODATA.Document_РеализацияТоваровУслуг"/>
          <Parameter Name="PostingModeOperational" Type="Edm.Boolean"/>
        </FunctionImport>
        <FunctionImport Name="Unpost" IsBindable="true" IsSideEffecting="true">
          <Parameter Name="bindingParameter" Type="StandardODATA.Document_РеализацияТоваровУслуг"/>
        </FunctionImport>
        <FunctionImport Name="SliceLast" IsBindable="true" IsSideEffecting="false"
                        ReturnType="Collection(StandardODATA.InformationRegister_КурсыВалют)">
          <Parameter Name="bindingParameter" Type="StandardODATA.InformationRegister_КурсыВалют"/>
          <Parameter Name="Condition" Type="Edm.String"/>
          <Parameter Name="Period" Type="Edm.DateTime"/>
        </FunctionImport>
      </EntityContainer>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
